{
  "cli": {
    "appVersionSource": "local"
  },
  "build": {
    "production": {
      "channel": "production",
      "android": {
        "credentialsSource": "local",
        "buildType": "app-bundle"
      },
      "ios": {
        "credentialsSource": "remote"
      }
    },
    "preview": {
      "channel": "preview",
      "distribution": "internal",
      "android": {
        "credentialsSource": "local",
        "buildType": "apk"
      },
      "ios": {
        "credentialsSource": "remote"
      }
    },
    "ios-simulator": {
      "developmentClient": true,
      "distribution": "internal",
      "ios": {
        "simulator": true
      }
    }
  }
}
