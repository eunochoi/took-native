{
  "expo": {
    "name": "took",
    "slug": "took-native",
    "version": "2.1.0",
    "scheme": "took-local",
    "orientation": "portrait",
    "platforms": ["android"],
    "userInterfaceStyle": "automatic",
    "icon": "./assets/icon.png",
    "android": {
      "package": "com.everstamp",
      "allowBackup": false,
      "blockedPermissions": [
        "android.permission.RECORD_AUDIO",
        "android.permission.CAMERA",
        "android.permission.READ_MEDIA_IMAGES",
        "android.permission.READ_MEDIA_VIDEO",
        "android.permission.READ_EXTERNAL_STORAGE",
        "android.permission.WRITE_EXTERNAL_STORAGE"
      ],
      "versionCode": 15
    },
    "plugins": [
      "expo-router",
      "expo-sqlite",
      "expo-font",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#FFFFFF",
          "image": "./assets/ui/wordmark.png",
          "imageWidth": 100
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "일기에 추가할 사진을 선택합니다.",
          "cameraPermission": false,
          "microphonePermission": false
        }
      ],
      "expo-asset",
      "expo-sharing",
      [
        "expo-status-bar",
        {
          "style": "dark"
        }
      ],
      "./plugins/withSamsungSoberWidget.cjs",
      [
        "react-native-android-widget",
        {
          "fonts": [
            "./assets/fonts/TmoneyRoundWindRegular.otf",
            "./assets/fonts/TmoneyRoundWindExtraBold.otf",
            "./node_modules/@expo/vector-icons/build/vendor/react-native-vector-icons/Fonts/Ionicons.ttf",
            "./node_modules/@expo/vector-icons/build/vendor/react-native-vector-icons/Fonts/MaterialCommunityIcons.ttf"
          ],
          "widgets": [
            {
              "name": "Sober",
              "label": "took 절제 타이머",
              "description": "선택한 절제 타이머의 경과 시간과 목표를 확인해요.",
              "minWidth": "110dp",
              "minHeight": "110dp",
              "targetCellWidth": 2,
              "targetCellHeight": 2,
              "resizeMode": "horizontal|vertical",
              "widgetFeatures": "reconfigurable",
              "updatePeriodMillis": 1800000,
              "previewImage": "./assets/widgets/sober-preview.png"
            }
          ]
        }
      ]
    ],
    "updates": {
      "enabled": false
    },
    "experiments": {
      "typedRoutes": true
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "b859b201-9bc7-42a0-889b-9b48bae5da45"
      }
    }
  }
}
