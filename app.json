{
  "expo": {
    "name": "포포툭",
    "slug": "took-native",
    "version": "2.1.9",
    "scheme": "took-local",
    "orientation": "portrait",
    "platforms": ["android", "ios"],
    "userInterfaceStyle": "automatic",
    "icon": "./assets/icon.png",
    "ios": {
      "bundleIdentifier": "com.took",
      "buildNumber": "5",
      "supportsTablet": false,
      "entitlements": {
        "com.apple.security.application-groups": ["group.com.took.widgets"]
      },
      "infoPlist": {
        "TookWidgetAppGroup": "group.com.took.widgets",
        "ITSAppUsesNonExemptEncryption": false
      }
    },
    "android": {
      "package": "com.everstamp",
      "allowBackup": false,
      "blockedPermissions": [
        "android.permission.RECORD_AUDIO",
        "android.permission.CAMERA",
        "android.permission.READ_MEDIA_IMAGES",
        "android.permission.READ_MEDIA_VIDEO",
        "android.permission.READ_EXTERNAL_STORAGE",
        "android.permission.WRITE_EXTERNAL_STORAGE"
      ],
      "versionCode": 29
    },
    "plugins": [
      "@bacons/apple-targets",
      "./plugins/withIosSceneLifecycle.cjs",
      "./plugins/withIosBuildSettings.cjs",
      "./plugins/withAndroidDevApp.cjs",
      "./plugins/withAndroidBuildSettings.cjs",
      "expo-router",
      "expo-sqlite",
      [
        "expo-notifications",
        {
          "icon": "./assets/notification-icon.png"
        }
      ],
      "expo-font",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#FFFFFF",
          "image": "./assets/ui/splash.png",
          "imageWidth": 240,
          "android": {
            "image": "./assets/ui/splash-android.png",
            "imageWidth": 228
          }
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "일기에 추가할 사진을 선택합니다.",
          "cameraPermission": false,
          "microphonePermission": false
        }
      ],
      "expo-asset",
      "expo-sharing",
      [
        "expo-status-bar",
        {
          "style": "dark"
        }
      ],
      "./plugins/withSamsungSoberWidget.cjs",
      [
        "react-native-android-widget",
        {
          "fonts": [
            "./assets/fonts/TmoneyRoundWindRegular.otf",
            "./assets/fonts/TmoneyRoundWindExtraBold.otf",
            "./node_modules/@expo/vector-icons/build/vendor/react-native-vector-icons/Fonts/Ionicons.ttf",
            "./node_modules/@expo/vector-icons/build/vendor/react-native-vector-icons/Fonts/MaterialCommunityIcons.ttf"
          ],
          "widgets": [
            {
              "name": "Sober",
              "label": "포포툭 거리두기 타이머",
              "description": "선택한 거리두기의 경과 시간과 목표를 확인해요.",
              "minWidth": "110dp",
              "minHeight": "110dp",
              "targetCellWidth": 2,
              "targetCellHeight": 2,
              "resizeMode": "horizontal|vertical",
              "widgetFeatures": "reconfigurable",
              "updatePeriodMillis": 1800000,
              "previewImage": "./assets/widgets/sober-preview.png"
            }
          ]
        }
      ]
    ],
    "updates": {
      "enabled": true,
      "fallbackToCacheTimeout": 2000,
      "url": "https://u.expo.dev/b859b201-9bc7-42a0-889b-9b48bae5da45",
      "requestHeaders": {
        "expo-channel-name": "production"
      }
    },
    "runtimeVersion": {
      "policy": "appVersion"
    },
    "experiments": {
      "typedRoutes": true
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "b859b201-9bc7-42a0-889b-9b48bae5da45"
      }
    },
    "locales": {
      "ko": "./assets/locales/ko.json",
      "en": "./assets/locales/en.json"
    }
  }
}
